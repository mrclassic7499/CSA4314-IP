# ==============================================================================
# Smart Parking Reservation and Slot Availability Management System
# Environment Configuration Template
# ==============================================================================

# Flask Server Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
PORT=5000

# Firebase Realtime Database - Server-Side Configuration (Admin SDK)
# Obtain from: Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com/
FIREBASE_CREDENTIALS_PATH=credentials/firebase-service-account.json

# Firebase Client-Side Web Configuration (Public API Credentials for Real-Time Listeners)
# Obtain from: Firebase Console -> Project Settings -> General -> Your Apps (Web App)
FIREBASE_API_KEY=AIzaSyYourClientApiKeyPlaceholder
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Default Seed Credentials for Admin and Attendant
DEFAULT_ADMIN_NAME="System Administrator"
DEFAULT_ADMIN_EMAIL=admin@smartparking.com
DEFAULT_ADMIN_PASSWORD=Admin@12345

DEFAULT_ATTENDANT_NAME="Parking Attendant"
DEFAULT_ATTENDANT_EMAIL=attendant@smartparking.com
DEFAULT_ATTENDANT_PASSWORD=Attendant@123
